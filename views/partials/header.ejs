<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Gestión de usuarios' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
  <nav>
    <span class="brand">Gestión de usuarios</span>
    <a href="/users">Usuarios</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/users/new">Alta de usuario</a>
      <a href="/groups">Grupos</a>
    <% } else if (currentUser.group_id) { %>
      <a href="/messages">Chat del grupo</a>
    <% } %>
    <span class="spacer"></span>
    <span class="who"><%= currentUser.name %> (<%= currentUser.role === 'admin' ? 'admin' : 'usuario' %>)</span>
    <form action="/logout" method="post" class="inline"><button type="submit" class="link">Salir</button></form>
  </nav>
<% } %>
<main>
<% if (flash) { %>
  <div class="flash <%= flash.type %>"><%= flash.text %></div>
<% } %>
